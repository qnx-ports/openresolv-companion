# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=openresolv
pkgver=3.17.0
pkgrel=0
pkgdesc="A framework for managing DNS information"
url="https://roy.marples.name/projects/openresolv"
arch="noarch"
license="BSD-2-Clause"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/NetworkConfiguration/openresolv/archive/refs/tags/v$pkgver.tar.gz
	detect_init-remove-irrelevant.patch
	"
options="!check"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sbindir=/usr/bin \
		--rundir=/run \
		--sysconfdir=/etc
	make
}

package() {
	make DESTDIR="$pkgdir" install
}


